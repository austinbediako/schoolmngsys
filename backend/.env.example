DB_HOST=localhost
DB_PORT=5432
DB_NAME=schoolmngsys
DB_USER=schoolmngsys
DB_PASSWORD=schoolmngsys
JWT_SECRET=replace-with-a-long-random-secret-value-at-least-32-bytes
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_MS=900000
AUTH_OTP_EXPIRATION_MS=600000
DOCUMENTS_STORAGE_DIR=./data/documents
SERVER_PORT=8080

# First-admin bootstrap (AdminAccountBootstrapper): creates a SYSTEM_ADMIN + HEAD_OF_SCHOOL
# account on startup if none exists yet. Leave BOOTSTRAP_ADMIN_PASSWORD unset — a random
# one-time password is generated per boot and printed once to the startup log; only pin it
# explicitly for a controlled first setup, and set BOOTSTRAP_ADMIN_ENABLED=false afterward.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@ubs.edu.gh
BOOTSTRAP_ADMIN_PASSWORD=

# Same rationale as above, for the bootstrapped demo Teacher account.
BOOTSTRAP_TEACHER_EMAIL=teacher@ubs.edu.gh
BOOTSTRAP_TEACHER_PASSWORD=

# CORS (CorsConfig): staff-console/guardian-portal run on their own dev-server origins. Vite picks
# its own port dynamically when the preferred one is taken, so in dev we allow any localhost port
# rather than pinning one. Set CORS_ALLOW_ANY_LOCALHOST_PORT=false and list exact production
# origins in CORS_ALLOWED_ORIGINS for any real deployment.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ANY_LOCALHOST_PORT=true
